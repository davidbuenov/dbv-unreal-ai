{
	"FileVersion": 3,
	"Version": 3,
	"VersionName": "0.3.0",
	"FriendlyName": "DBV Unreal AI Toolset (C++)",
	"Description": "Native GPU 3D Gaussian Splatting renderer and C++ toolset for DBV Unreal AI. 100% open-source (MIT).",
	"Category": "Rendering",
	"CreatedBy": "David Bueno Vallejo, David Bueno Carmona",
	"CreatedByURL": "https://github.com/davidbuenov/dbv-unreal-ai",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "DBVUnrealAICppRender",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit"
		},
		{
			"Name": "DBVUnrealAICpp",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "DBVUnrealAI",
			"Enabled": true
		},
		{
			"Name": "PythonScriptPlugin",
			"Enabled": true
		},
		{
			"Name": "ToolsetRegistry",
			"Enabled": true
		}
	]
}
